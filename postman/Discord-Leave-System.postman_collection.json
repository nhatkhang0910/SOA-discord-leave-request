{
  "info": {
    "_postman_id": "7f9c5d5b-5f4a-4d1f-9a8f-1c5d1c0a2026",
    "name": "Discord Leave Request System",
    "description": "Test the Leave Request API, including the Discord Bot result callback endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeID",
      "value": "NV001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Employee",
      "item": [
        {
          "name": "1. Create Leave Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeName\": \"Nguyen Van A\",\n  \"employeeID\": \"{{employeeID}}\",\n  \"reason\": \"Family matter\",\n  \"fromDate\": \"25/09/2026\",\n  \"toDate\": \"27/09/2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employee/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employee",
                "leave-requests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('requestId', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get Leave Request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employee/leave-requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employee",
                "leave-requests",
                "{{requestId}}"
              ]
            }
          }
        },
        {
          "name": "3. Get Requests By Employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employee/leave-requests/by-employee/{{employeeID}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employee",
                "leave-requests",
                "by-employee",
                "{{employeeID}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Manager",
      "item": [
        {
          "name": "4. Get Pending Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/boss/leave-requests?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "boss",
                "leave-requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "5. Approve Leave Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewerName\": \"Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boss/leave-requests/{{requestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "boss",
                "leave-requests",
                "{{requestId}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "6. Reject Leave Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewerName\": \"Manager\",\n  \"reasonForRejection\": \"Not enough staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boss/leave-requests/{{requestId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "boss",
                "leave-requests",
                "{{requestId}}",
                "reject"
              ]
            }
          }
        },
        {
          "name": "7. Simulate Discord Approve Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"action\": \"approve\",\n  \"reviewerName\": \"Manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/discord/result"
          }
        },
        {
          "name": "8. Simulate Discord Reject Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"action\": \"reject\",\n  \"reviewerName\": \"Manager\",\n  \"reason\": \"Not enough staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/discord/result"
          }
        }
      ]
    }
  ]
}
